# Kopyalayıp .env yapın; üretimde sadece secret yönetimi (Vault/K8s) kullanın.
#
# Yerel Docker: .env şart değil — insaat-erp klasöründe: docker compose up --build
# (varsayılan DB şifresi ve JWT compose içinde; üretimde asla kullanmayın)
NODE_ENV=development
PORT=3000

# JWT (zorunlu; compose içine yazmayın)
JWT_SECRET=degistir_uzun_rastgele_anahtar
JWT_EXPIRES_IN=7d

# Kök / adresinde tarayıcıya gösterilecek ERP web linki (opsiyonel; yoksa https://finskor.tr)
# PUBLIC_ERP_WEB_URL=https://finskor.tr

# CORS, virgülle (docker-compose.yml api için varsayılanlara finskor.tr eklenir; buradan genişletebilirsiniz)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://finskor.tr,https://www.finskor.tr

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# PostgreSQL — yerel: ayrı alanlar. Bulut (Render vb.): yalnızca DATABASE_URL yeterli
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insaat_erp
DB_USER=erp_user
DB_PASSWORD=guvenli_sifre

# Düzey: debug | info | warn | error
LOG_LEVEL=info

# Smoke
# SMOKE_BASE=http://127.0.0.1:3000

# Masaüstü (Vite) — frontend .env.electron: VITE_API_BASE=http://127.0.0.1:3000
# Backend CORS; Origin: null (Electron) izinli.
